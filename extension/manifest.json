{
  "manifest_version": 3,
  "name": "Срез — проверка контрагента",
  "version": "0.1.0",
  "description": "Локальная проверка контрагента: запросы идут с компьютера пользователя, без вашего сервера.",
  "action": {
    "default_title": "Срез",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "clipboardWrite", "tabs"],
  "host_permissions": [
    "https://egrul.nalog.ru/*",
    "https://pb.nalog.ru/*",
    "https://www.nalog.gov.ru/*",
    "https://file.nalog.ru/*",
    "https://bankrot.fedresurs.ru/*",
    "https://fedresurs.ru/*",
    "https://kad.arbitr.ru/*",
    "https://www.vestnik-gosreg.ru/*",
    "https://fssp.gov.ru/*"
  ]
}
